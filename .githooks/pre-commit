#!/bin/sh
# Pre-commit hook to ensure repository health before every commit.

echo "Running pre-commit health checks via 'did test'..."

did test

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo "❌ Pre-commit health checks failed. Please resolve test violations before committing."
    exit 1
fi

echo "✅ Health checks passed. Proceeding with commit."
exit 0
