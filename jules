const log = debug("jules");

marked.setOptions({
  renderer: new TerminalRenderer()
});

function isColorSupported() {
  if (process.env.NO_COLOR !== undefined) return false;
  if (process.argv.includes("--no-color")) return false;
  return Boolean(process.stdout.isTTY);
}

function renderMarkdown(mdText) {
  if (!mdText) return "";
  if (isColorSupported()) {
    return marked.parse(mdText);
  }
  return mdText.trim();
}

const API_KEY = process.env.JULES_API_KEY;
const BASE_URL = process.env.JULES_API_URL || "https://jules.googleapis.com/v1alpha";

const cachedFetch = NodeFetchCache.create({
  cache: new FileSystemCache({
    cacheDir: path.join(os.homedir(), '.jules-cache')
  }),
});

const sessionPatches = new Map();

function getInterdiff(previousPatch, currentPatch, sessionId) {
  if (!currentPatch) return "";
  if (previousPatch && previousPatch.trim() === currentPatch.trim()) return "";

  const cleanId = sessionId ? sessionId.replace(/^sessions\//, "") : "session";
  const prevTmpPath = path.join(os.tmpdir(), `jules-${cleanId}-prev.patch`);
  const currTmpPath = path.join(os.tmpdir(), `jules-${cleanId}-curr.patch`);

  try {
    fs.writeFileSync(prevTmpPath, previousPatch || "", "utf8");
    fs.writeFileSync(currTmpPath, currentPatch || "", "utf8");
    const output = execFileSync("interdiff", [prevTmpPath, currTmpPath], {
      encoding: "utf8",
      timeout: 1000,
      stdio: ["ignore", "pipe", "pipe"]
    });
    if (output && output.trim()) {
      return output.trim();
    }
  } catch (err) {
    log(`System interdiff unavailable or failed, falling back to JS implementation: ${err.message}`);
  } finally {
    try { if (fs.existsSync(prevTmpPath)) fs.unlinkSync(prevTmpPath); } catch (e) {}
    try { if (fs.existsSync(currTmpPath)) fs.unlinkSync(currTmpPath); } catch (e) {}
  }

  return computeInterdiff(previousPatch, currentPatch);
}

function readAndFormatLocalFile(filepath) {
  if (!filepath) {
    throw new Error("File path is required.");
  }
  const resolvedPath = path.resolve(filepath);
  if (!fs.existsSync(resolvedPath)) {
    throw new Error(`File not found: ${filepath}`);
  }
  const stat = fs.statSync(resolvedPath);
  if (!stat.isFile()) {
    throw new Error(`Path is not a regular file: ${filepath}`);
  }

  const binaryOrImageExts = [
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".ico", ".bmp", ".tiff",
    ".pdf", ".zip", ".tar", ".gz", ".7z", ".rar", ".exe", ".dll", ".so", ".dylib",
    ".bin", ".iso"
  ];
  const ext = path.extname(resolvedPath).toLowerCase();
  if (binaryOrImageExts.includes(ext)) {
    throw new Error(`Binary/image files are not supported: ${filepath}`);
  }

  const buf = fs.readFileSync(resolvedPath);
  for (let i = 0; i < Math.min(buf.length, 8000); i++) {
    if (buf[i] === 0) {
      throw new Error(`Binary/image files are not supported: ${filepath}`);
    }
  }

  const content = buf.toString("utf8");
  const relPath = path.relative(process.cwd(), resolvedPath) || path.basename(resolvedPath);
  const lang = ext.slice(1) || "";

  return `\n\n--- File: ${relPath} ---\n\`\`\`${lang}\n${content}\n\`\`\``;
}

function expandAtFilepaths(promptText) {
  if (!promptText) return promptText;
  const atMatches = promptText.match(/(?:^|\s)@([^\s]+)/g);
  if (!atMatches) return promptText;

  let fileAdditions = "";
  for (const rawMatch of atMatches) {
    const match = rawMatch.trim();
    const filepath = match.slice(1);
    const resolvedPath = path.resolve(filepath);
    const exists = fs.existsSync(resolvedPath);

    if (exists) {
      fileAdditions += readAndFormatLocalFile(filepath);
    } else if (filepath.startsWith("./") || filepath.startsWith("../") || filepath.startsWith("/") || filepath.startsWith("~")) {
      throw new Error(`File not found: ${filepath}`);
    }
  }
  return promptText + fileAdditions;
}

async function readStdin() {
  if (process.stdin.isTTY) {
    return "";
  }
  return new Promise((resolve, reject) => {
    let content = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => {
      content += chunk;
    });
    process.stdin.on("end", () => {
      resolve(content);
    });
    process.stdin.on("error", (err) => {
      reject(err);
    });
  });
}

async function apiRequest(endpoint, method = "GET", body = null, bypassCache = false, retries = 2) {
  const disableCacheEnv = process.env.JULES_DISABLE_CACHE === "true" || process.env.JULES_DISABLE_CACHE === "1";
  const shouldBypass = bypassCache || disableCacheEnv;

  log(`API Request: ${method} ${endpoint} (bypassCache: ${shouldBypass})`);
  const options = {
    method,
    headers: {
      "X-Goog-Api-Key": API_KEY,
      "Content-Type": "application/json",
    },
  };
  if (body) {
    log(`Request Body: %O`, body);
    options.body = JSON.stringify(body);
  }

  const fetcher = shouldBypass ? fetch : cachedFetch;
  let attempt = 0;
  while (true) {
    const res = await fetcher(`${BASE_URL}/${endpoint}`, options);
    if (!res.ok) {
      const errorText = await res.text();
      log(`API Error: ${res.status} - ${errorText}`);
      if (res.status === 429 && attempt < retries) {
        attempt++;
        const backoffDelay = process.env.JULES_POLL_INTERVAL ? 10 : attempt * 2000;
        log(`HTTP 429 encountered in apiRequest. Retrying in ${backoffDelay}ms (attempt ${attempt}/${retries})...`);
        await new Promise((res) => setTimeout(res, backoffDelay));
        continue;
      }
      const err = new Error(`API Error (${res.status}): ${errorText}`);
      err.status = res.status;
      throw err;
    }
    const data = await res.json();
    log(`API Response from ${endpoint}: %O`, data);
    return data;
  }
}

async function fetchSources() {
  const response = await apiRequest("sources", "GET", null, true);
  const sources = Array.isArray(response) ? response : response.sources;
  if (!Array.isArray(sources)) {
    throw new Error("Unexpected response format from API");
  }
  return sources;
}

async function listSources() {
  console.error(`\x1b[36mFetching sources...\x1b[0m\n`);
  try {
    const sources = await fetchSources();
    if (sources.length === 0) {
      console.error("No sources found.");
      return;
    }
    
    let table = "| Source Name | GitHub Repo | Default Branch |\n";
    table += "| --- | --- | --- |\n";
    
    sources.forEach(s => {
      const name = s.name || "unknown";
      const repo = s.githubRepo ? `${s.githubRepo.owner}/${s.githubRepo.repo}` : "unknown";
      const branch = s.githubRepo?.defaultBranch?.displayName || "unknown";
      table += `| ${name} | ${repo} | ${branch} |\n`;
    });

    console.log(renderMarkdown(table));
    console.error("");
  } catch (err) {
    console.error(`\x1b[31mError listing sources: ${err.message}\x1b[0m`);
  }
}

async function fetchSessions() {
  const response = await apiRequest("sessions", "GET", null, true);
  const sessions = Array.isArray(response) ? response : response.sessions;
  if (!Array.isArray(sessions)) {
    throw new Error("Unexpected response format from API");
  }
  return sessions;
}

async function listSessions() {
  console.error(`\x1b[36mFetching sessions...\x1b[0m\n`);
  try {
    const sessions = await fetchSessions();
    if (sessions.length === 0) {
      console.error("No sessions found.");
      return;
    }
    return listSessionsFromList(sessions);
  } catch (err) {
    console.error(`\x1b[31mError listing sessions: ${err.message}\x1b[0m`);
  }
}

function formatSourceDisplay(s) {
  let source = s.source || s.sourceId || s.sourceName;
  if (typeof source === "object" && source !== null) {
    source = source.name || source.id || source.sourceId || "none";
  }
  if (typeof source === "string" && source) {
    if (source.startsWith("sources/github/")) {
      return source.replace(/^sources\/github\//, "");
    }
    if (source.startsWith("sources/")) {
      return source.replace(/^sources\//, "");
    }
    return source;
  }
  return "none";
}

function listSessionsFromList(sessions) {
    if (sessions.length === 0) {
      console.error("No sessions found.");
      return;
    }

    let table = "| ID | Source | State | Created |\n";
    table += "| --- | --- | --- | --- |\n";
    
    sessions.forEach(s => {
      const id = s.name || s.id || "unknown";
      const source = formatSourceDisplay(s);
      const state = s.state || "unknown";
      const created = s.createTime || "unknown";
      table += `| ${id} | ${source} | ${state} | ${created} |\n`;
    });

    console.log(renderMarkdown(table));
}

async function archiveSession(sessionId) {
  return await apiRequest(`${sessionId}:archive`, "POST");
}

async function cleanup() {
  console.error(`\x1b[36mCleaning up old sessions (older than 7 days)...\x1b[0m`);
  try {
    const sessions = await fetchSessions();
    if (sessions.length === 0) {
      console.error("No sessions found to clean up.");
      return;
    }

    const now = new Date();
    const oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    
    let archivedCount = 0;
    for (const s of sessions) {
      const createTime = new Date(s.createTime);
      if (createTime < oneWeekAgo) {
        const sessionId = s.name || s.id;
        try {
          await archiveSession(sessionId);
          console.error(`\x1b[32mArchived:\x1b[0m ${sessionId} (${s.createTime})`);
          archivedCount++;
        } catch (err) {
          console.error(`\x1b[31mFailed to archive ${sessionId}: ${err.message}\x1b[0m`);
        }
      }
    }

    if (archivedCount === 0) {
      console.error("No sessions older than a week were found.");
    } else {
      console.error(`\n\x1b[32mSuccessfully archived ${archivedCount} sessions.\x1b[0m`);
    }
  } catch (err) {
    console.error(`\x1b[31mError during cleanup: ${err.message}\x1b[0m`);
  }
}

async function fetchAllActivities(sessionId) {
  let allActivities = [];
  let nextPageToken = null;

  do {
    const endpoint = nextPageToken 
      ? `${sessionId}/activities?pageToken=${nextPageToken}` 
      : `${sessionId}/activities`;
    
    const response = await apiRequest(endpoint, "GET", null, true);
    const activities = response.activities || [];
    allActivities = allActivities.concat(activities);
    nextPageToken = response.nextPageToken;
  } while (nextPageToken);

  return allActivities;
}

function hasJulesFinishedWork(activities = [], session = {}) {
  if (!session) return false;
  if (session.state === "COMPLETED" || session.state === "AWAITING_USER_INPUT") return true;

  if (Array.isArray(activities)) {
    for (const act of activities) {
      if (act.sessionCompleted) return true;
      if (act.artifacts && Array.isArray(act.artifacts)) {
        for (const art of act.artifacts) {
          if (art.changeSet && art.changeSet.gitPatch) return true;
        }
      }
    }
  }
  return false;
}

async function createSession(prompt, sourceId = null) {
  let finalSourceId = sourceId;

  if (sourceId !== null && sourceId !== undefined) {
    if (typeof sourceId !== "string" || !sourceId.trim() || sourceId === "true" || sourceId === "false") {
      throw new Error(`Invalid source parameter: '${sourceId}'. A valid source string (e.g. owner/repo or sources/...) is required when --source is specified.`);
    }

    log(`Attempting to resolve source ID: ${sourceId}`);
    try {
      const sources = await fetchSources();
      if (!sourceId.startsWith("sources/")) {
        const matchedSource = sources.find(s =>
          s.githubRepo && `${s.githubRepo.owner}/${s.githubRepo.repo}` === sourceId
        );
        if (matchedSource) {
          finalSourceId = matchedSource.name;
          log(`Resolved ${sourceId} to ${finalSourceId}`);
        } else {
          throw new Error(`Source not found: ${sourceId}. Please use 'jules sources' to find a valid source name.`);
        }
      } else {
        const exists = sources.some(s => s.name === sourceId || s.id === sourceId);
        if (!exists && sources.length > 0) {
          throw new Error(`Source not found: ${sourceId}. Please use 'jules sources' to find a valid source name.`);
        }
      }
    } catch (err) {
      throw new Error(`Failed to resolve source: ${err.message}`);
    }
  }

  console.error(`\x1b[36mCreating session...`);
  const body = { prompt };
  if (finalSourceId) {
    body.source = finalSourceId;
    console.error(`\x1b[90mSource ID:\x1b[0m ${finalSourceId}`);
  }
  console.error(`\x1b[90mPrompt:\x1b[0m "${prompt}"`);
  
  const session = await apiRequest("sessions", "POST", body);
  console.error(`\x1b[32mSession created successfully!\x1b[0m ID: ${session.name}`);
  return session.name;
}

function isRateLimitError(err) {
  return (err && err.status === 429) || (err && err.message && err.message.includes("429"));
}

function handlePollingError(err, context = "background loop") {
  if (isRateLimitError(err)) {
    if (process.env.DEBUG) {
      console.error(`\x1b[31mError in ${context}: ${err.message}\x1b[0m`);
    } else {
      console.error(`\x1b[33m⚠️ Rate limit reached (HTTP 429). Retrying with backoff...\x1b[0m`);
    }
  } else if (err.message && err.message.includes("API Error (404)")) {
    log(`Resource not yet available (404), retrying...`);
  } else {
    console.error(`\x1b[31mError in ${context}: ${err.message}\x1b[0m`);
  }
}

async function tail(sessionId, options = {}) {
  const fullSessionId = sessionId.startsWith("sessions/") ? sessionId : `sessions/${sessionId}`;
  console.error(`\x1b[36mTailing session:\x1b[0m ${fullSessionId}...\n`);

  let lastSeenActivityIndex = -1;
  let lastState = null;
  let lastUpdateTime = null;

  const basePollInterval = process.env.JULES_POLL_INTERVAL ? parseInt(process.env.JULES_POLL_INTERVAL, 10) : 3000;
  let currentPollInterval = basePollInterval;

  while (true) {
    try {
      // Check session state
      const session = await apiRequest(fullSessionId, "GET", null, true);

      if (session.state !== lastState) {
        process.stderr.write(`\n\x1b[33m[${new Date().toLocaleTimeString()}] State: ${session.state}\x1b[0m\n`);
        lastState = session.state;
      }

      // Check activities only if the session has been updated
      if (session.updateTime !== lastUpdateTime) {
        const activities = await fetchAllActivities(fullSessionId);

        if (lastSeenActivityIndex === -1 && !options.history) {
          lastSeenActivityIndex = activities.length - 1;
        } else if (activities.length > lastSeenActivityIndex + 1) {
          for (let i = lastSeenActivityIndex + 1; i < activities.length; i++) {
            try {
              printActivity(i, activities[i], fullSessionId, options);
            } catch (err) {
              console.error(`\x1b[31mError printing activity ${i}: ${err.message}\x1b[0m`);
            }
          }
          lastSeenActivityIndex = activities.length - 1;
        }
        lastUpdateTime = session.updateTime;
      }
      currentPollInterval = basePollInterval;
    } catch (err) {
      if (isRateLimitError(err)) {
        currentPollInterval = process.env.JULES_POLL_INTERVAL ? basePollInterval : Math.min(currentPollInterval * 2, 30000);
      }
      handlePollingError(err, "tail command");
    }
    await new Promise((res) => setTimeout(res, currentPollInterval));
  }
}

async function sendMessageAndTail(sessionId, message, options = {}) {
  const fullSessionId = sessionId.startsWith("sessions/") ? sessionId : `sessions/${sessionId}`;
  console.error(`\x1b[36mSending message to session:\x1b[0m ${fullSessionId}...\n`);

  let lastSeenActivityIndex = -1;
  let initialUpdateTime = null;
  try {
    const session = await apiRequest(fullSessionId, "GET", null, true);
    initialUpdateTime = session.updateTime;
    const initialActivities = await fetchAllActivities(fullSessionId);
    lastSeenActivityIndex = initialActivities.length - 1;
  } catch (err) {
    // If initial fetch fails, start at -1
  }

  await apiRequest(`${fullSessionId}:sendMessage`, "POST", { prompt: message });
  console.error(`\x1b[90m(Message sent... Waiting for Jules to complete...)\x1b[0m\n`);

  let lastState = null;
  let lastUpdateTime = initialUpdateTime;
  let hasCompletedActivity = false;
  let hasFailedActivity = false;
  let hasStarted = false;
  const startIndex = lastSeenActivityIndex;

  const basePollInterval = process.env.JULES_POLL_INTERVAL ? parseInt(process.env.JULES_POLL_INTERVAL, 10) : 3000;
  let currentPollInterval = basePollInterval;

  while (true) {
    try {
      const session = await apiRequest(fullSessionId, "GET", null, true);

      if (session.state !== lastState) {
        process.stderr.write(`\n\x1b[33m[${new Date().toLocaleTimeString()}] State: ${session.state}\x1b[0m\n`);
        lastState = session.state;
      }

      if (session.state === "ACTIVE" || session.state === "IN_PROGRESS") {
        hasStarted = true;
      }

      if (session.updateTime !== lastUpdateTime) {
        const activities = await fetchAllActivities(fullSessionId);

        if (activities.length > lastSeenActivityIndex + 1) {
          for (let i = lastSeenActivityIndex + 1; i < activities.length; i++) {
            const act = activities[i];
            if (act.sessionCompleted) hasCompletedActivity = true;
            if (act.sessionFailed) hasFailedActivity = true;
            try {
              printActivity(i, act, fullSessionId, options);
            } catch (err) {
              console.error(`\x1b[31mError printing activity ${i}: ${err.message}\x1b[0m`);
            }
          }
          lastSeenActivityIndex = activities.length - 1;
        }
        lastUpdateTime = session.updateTime;
      }

      if (lastSeenActivityIndex > startIndex || (initialUpdateTime && session.updateTime !== initialUpdateTime)) {
        hasStarted = true;
      }

      if (session.state === "COMPLETED" || hasCompletedActivity) {
        console.error(`\n\x1b[32m✔ Jules is done. Process exiting.\x1b[0m\n`);
        process.exit(0);
      }

      if (session.state === "FAILED" || session.state === "CANCELLED" || hasFailedActivity) {
        console.error(`\n\x1b[31m❌ Session finished with state: ${session.state}\x1b[0m\n`);
        process.exit(1);
      }

      if (hasStarted && session.state === "AWAITING_USER_INPUT") {
        console.error(`\n\x1b[32m✔ Jules is done. Process exiting.\x1b[0m\n`);
        process.exit(0);
      }
      currentPollInterval = basePollInterval;
    } catch (err) {
      if (isRateLimitError(err)) {
        currentPollInterval = process.env.JULES_POLL_INTERVAL ? basePollInterval : Math.min(currentPollInterval * 2, 30000);
      }
      handlePollingError(err, "send command");
    }
    await new Promise((res) => setTimeout(res, currentPollInterval));
  }
}

function printActivity(index, activity, sessionId = null, options = {}) {
  log(`Printing Activity ${index}: %O`, activity);
  const time = activity.createTime ? `\x1b[90m[${activity.createTime}]\x1b[0m ` : "";
  const originator = activity.originator || "Unknown";
  const color = originator === "agent" ? "\x1b[34m" : originator === "user" ? "\x1b[32m" : "\x1b[35m";
  
  console.error(`\n\x1b[1m--- Activity ${index} ---\x1b[0m`);
  console.error(`${time}${color}${originator.toUpperCase()}\x1b[0m`);

  if (activity.type) {
    console.error(`\x1b[90mType: ${activity.type}\x1b[0m`);
  }

  // 1. Print Messages
  if (activity.agentMessaged && activity.agentMessaged.agentMessage) {
    console.log(`\n${renderMarkdown(activity.agentMessaged.agentMessage)}\n`);
  } else if (activity.userMessaged && activity.userMessaged.userMessage) {
    console.log(`\n${renderMarkdown(activity.userMessaged.userMessage)}\n`);
  }

  // 2. Print Special Activity Types
  if (activity.planGenerated && activity.planGenerated.plan) {
    const plan = activity.planGenerated.plan;
    let planMd = `# Plan Generated (ID: ${plan.id})\n\n`;
    plan.steps.forEach((step, i) => {
      planMd += `${i + 1}. **${step.title}**: ${step.description}\n`;
    });
    console.log(`\n${renderMarkdown(planMd)}`);
    console.error(`\x1b[90m(This is a plan generated by Jules. Type /approve to approve it.)\x1b[0m\n`);
  } else if (activity.planApproved) {
    console.error(`\n\x1b[32m✔ Plan Approved (ID: ${activity.planApproved.planId})\x1b[0m\n`);
  } else if (activity.progressUpdated) {
    const prog = activity.progressUpdated;
    let md = "";
    if (prog.title) md += `# ${prog.title}\n\n`;
    if (prog.description) md += `${prog.description}\n`;
    if (md) console.log(`\n${renderMarkdown(md)}\n`);
  } else if (activity.sessionCompleted) {
    console.error(`\n\x1b[32m🎉 Session Completed Successfully\x1b[0m\n`);
  } else if (activity.sessionFailed && activity.sessionFailed.reason) {
    console.error(`\n\x1b[31m❌ Session Failed\x1b[0m`);
    console.error(`Reason: ${activity.sessionFailed.reason}\n`);
  }

  // 3. Print Structured Data
  for (const [key, value] of Object.entries(activity)) {
    if (["type", "createTime", "name", "originator", "agentMessaged", "userMessaged", "id", "planGenerated", "planApproved", "sessionCompleted", "sessionFailed", "progressUpdated"].includes(key)) continue;
    
    if (key === "artifacts" && Array.isArray(value)) {
      value.forEach((art, i) => {
        console.error(`\x1b[32mArtifact ${i}:\x1b[0m`);
        if (art.changeSet && art.changeSet.gitPatch && art.changeSet.gitPatch.unidiffPatch) {
          const currentPatch = art.changeSet.gitPatch.unidiffPatch;
          const cleanId = sessionId ? sessionId.replace(/^sessions\//, "") : "session";
          const previousPatch = sessionPatches.get(cleanId) || "";

          try {
            const tmpPath = path.join(os.tmpdir(), `jules-${cleanId}.patch`);
            fs.writeFileSync(tmpPath, currentPatch, "utf8");
            console.error(`\x1b[36m📄 Patch saved to:\x1b[0m ${tmpPath}`);
            console.error(`\x1b[90m💡 Apply to repository:\x1b[0m git apply ${tmpPath}\n`);

            if (options && options.gitPatch) {
              try {
                execFileSync("git", ["apply", tmpPath], { cwd: process.cwd(), encoding: "utf8" });
                console.error(`\x1b[32m✔ Automatically applied git patch to repository:\x1b[0m git apply ${tmpPath}\n`);
              } catch (applyErr) {
                console.error(`\x1b[31m❌ Error automatically applying git patch: ${applyErr.message}\x1b[0m\n`);
              }
            }
          } catch (err) {
            console.error(`\x1b[31mFailed to save patch file: ${err.message}\x1b[0m`);
          }

          const interdiff = getInterdiff(previousPatch, currentPatch, sessionId);
          sessionPatches.set(cleanId, currentPatch);

          if (interdiff) {
            console.error(`\x1b[36mStep Interdiff:\x1b[0m`);
            console.log(renderMarkdown(`\`\`\`diff\n${interdiff}\n\`\`\``));
          }
        } else if (art.bashOutput) {
          const bash = art.bashOutput;
          console.error(`\x1b[90mCommand:\x1b[0m ${bash.command}`);
          console.error(`\x1b[90mOutput:\x1b[0m\n${bash.output}`);
          console.error(`\x1b[90mExit Code:\x1b[0m ${bash.exitCode}`);
        } else {
          console.error(JSON.stringify(art, null, 2));
        }
      });
    } else if (typeof value === "object" && value !== null) {
      console.error(`\x1b[32m${key}:\x1b[0m\n${JSON.stringify(value, null, 2)}`);
    } else {
      console.error(`\x1b[32m${key}:\x1b[0m ${value}`);
    }
  }

  if (activity.id) {
    console.error(`\x1b[90mID: ${activity.id}\x1b[0m`);
  }
  console.error(`\x1b[90m--------------------------\x1b[0m`);
}

async function repl(sessionId, options = {}) {
  let hasPulledForWork = false;

  if (options.gitPull) {
    try {
      console.error(`\x1b[36mRunning 'git pull'...\x1b[0m`);
      const output = execSync("git pull", { encoding: "utf8" });
      console.error(output);
      hasPulledForWork = true;
    } catch (err) {
      console.error(`\x1b[31m❌ Error running 'git pull': ${err.message}\x1b[0m`);
    }
  }

  let targetSessionId = sessionId;
  if (!targetSessionId) {
    try {
      const sessions = await fetchSessions();
      if (sessions.length === 0) {
        console.error("\x1b[31m❌ Error: No sessions found for REPL.\x1b[0m");
        process.exit(1);
      }
      targetSessionId = sessions[0].name || sessions[0].id;
      console.log(`\x1b[90mNo session ID provided. Defaulting to latest: ${targetSessionId}\x1b[0m`);
    } catch (err) {
      console.error(`\x1b[31m❌ Error fetching latest session: ${err.message}\x1b[0m`);
      process.exit(1);
    }
  }
  const fullSessionId = targetSessionId.startsWith("sessions/") ? targetSessionId : `sessions/${targetSessionId}`;
  const shortSessionId = fullSessionId.replace(/^sessions\//, "");
  let basePromptLabel = shortSessionId;

  if (options.name) {
    basePromptLabel = options.name;
  } else {
    try {
      const sessionInfo = await apiRequest(fullSessionId, "GET", null, true);
      let source = sessionInfo.source || sessionInfo.sourceId;
      if (source) {
        if (source.startsWith("sources/github/")) {
          source = source.replace(/^sources\/github\//, "");
        } else if (source.startsWith("sources/")) {
          source = source.replace(/^sources\//, "");
        }
        basePromptLabel = `${source}:${shortSessionId}`;
      }
    } catch (err) {
      log(`Failed to fetch session info for prompt source label: ${err.message}`);
    }
  }

  console.log(`\x1b[36mJules REPL started for session:\x1b[0m ${fullSessionId}`);
  console.log(`\x1b[90mType your message and press Enter. Press Ctrl+C to exit.\x1b[0m\n`);

  function getQueueFilePath(sessionId) {
    const cleanId = sessionId.replace(/^sessions\//, "");
    const queueDir = path.join(os.homedir(), ".jules-cache", "queues");
    if (!fs.existsSync(queueDir)) {
      fs.mkdirSync(queueDir, { recursive: true });
    }
    return path.join(queueDir, `${cleanId}.json`);
  }

  function saveQueue(sessionId, queue) {
    try {
      const queueFile = getQueueFilePath(sessionId);
      if (queue.length === 0) {
        if (fs.existsSync(queueFile)) {
          fs.unlinkSync(queueFile);
        }
      } else {
        fs.writeFileSync(queueFile, JSON.stringify(queue, null, 2), "utf8");
      }
    } catch (err) {
      log(`Failed to save queue for ${sessionId}: ${err.message}`);
    }
  }

  function loadQueue(sessionId) {
    try {
      const queueFile = getQueueFilePath(sessionId);
      if (fs.existsSync(queueFile)) {
        const data = fs.readFileSync(queueFile, "utf8");
        const parsed = JSON.parse(data);
        if (Array.isArray(parsed)) {
          return parsed;
        }
      }
    } catch (err) {
      log(`Failed to load queue for ${sessionId}: ${err.message}`);
    }
    return [];
  }

  let isBusy = false;
  const messageQueue = loadQueue(fullSessionId);
  let promptColorCode = "\x1b[32m";

  function getPromptString() {
    const queueSuffix = messageQueue.length > 0 ? ` [${messageQueue.length}]` : "";
    return `${promptColorCode}${basePromptLabel}${queueSuffix} > \x1b[0m`;
  }

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    prompt: getPromptString()
  });

  function updatePrompt() {
    rl.setPrompt(getPromptString());
  }

  rl.prompt();

  let lastSeenActivityIndex = -1;
  let lastState = null;
  let lastUpdateTime = null;

  async function flushQueue() {
    if (messageQueue.length > 0 && !isBusy) {
      const combinedPayload = messageQueue.join("\n\n---\n\n");
      messageQueue.length = 0;
      saveQueue(fullSessionId, messageQueue);
      updatePrompt();
      console.log(`\n\x1b[36m📤 Sending queued message(s) to Jules...\x1b[0m`);
      isBusy = true;
      try {
        await apiRequest(`${fullSessionId}:sendMessage`, "POST", { prompt: combinedPayload });
        console.log(`\x1b[90m(Message sent... Agent is thinking...)\x1b[0m`);
      } catch (err) {
        console.error(`\x1b[31mError sending queued messages: ${err.message}\x1b[0m`);
        isBusy = false;
      }
    }
  }

  const basePollInterval = process.env.JULES_POLL_INTERVAL ? parseInt(process.env.JULES_POLL_INTERVAL, 10) : 3000;
  let currentPollInterval = basePollInterval;

  async function poll() {
    try {
      // Check session state
      const session = await apiRequest(fullSessionId, "GET", null, true);
      if (session.state !== lastState) {
        process.stdout.write(`\n\x1b[33m[${new Date().toLocaleTimeString()}] State: ${session.state}\x1b[0m\n`);
        lastState = session.state;
        if (session.state === "AWAITING_USER_INPUT" || session.state === "AWAITING_USER_FEEDBACK" || session.state === "COMPLETED" || session.state === "FAILED" || session.state === "CANCELLED") {
          isBusy = false;
        } else if (session.state === "IN_PROGRESS" || session.state === "ACTIVE") {
          isBusy = true;
        }
        rl.prompt(true);
      }

      // Check activities only if the session has been updated
      if (session.updateTime !== lastUpdateTime) {
        const activities = await fetchAllActivities(fullSessionId);

        if (lastSeenActivityIndex === -1 && !options.history) {
          lastSeenActivityIndex = activities.length - 1;
        } else if (activities.length > lastSeenActivityIndex + 1) {
          for (let i = lastSeenActivityIndex + 1; i < activities.length; i++) {
            try {
              printActivity(i, activities[i], fullSessionId, options);
            } catch (err) {
              console.error(`\x1b[31mError in REPL background loop: ${err.message}\x1b[0m`);
            }
          }
          lastSeenActivityIndex = activities.length - 1;
          rl.prompt(true);
        }
        lastUpdateTime = session.updateTime;

        if (options.gitPull && !hasPulledForWork && hasJulesFinishedWork(activities, session)) {
          hasPulledForWork = true;
          try {
            console.error(`\x1b[36mJules is done with work. Running 'git pull'...\x1b[0m`);
            const output = execSync("git pull", { encoding: "utf8" });
            console.error(output);
          } catch (err) {
            console.error(`\x1b[31m❌ Error running 'git pull': ${err.message}\x1b[0m`);
          }
        }
      }

      if (session.state === "AWAITING_USER_INPUT" || session.state === "AWAITING_USER_FEEDBACK" || session.state === "COMPLETED") {
        isBusy = false;
        await flushQueue();
      }
      currentPollInterval = basePollInterval;
    } catch (err) {
      if (isRateLimitError(err)) {
        currentPollInterval = process.env.JULES_POLL_INTERVAL ? basePollInterval : Math.min(currentPollInterval * 2, 30000);
      }
      handlePollingError(err, "REPL background loop");
      rl.prompt(true);
    }
    
    // Schedule next poll
    tailTimeout = setTimeout(poll, currentPollInterval);
  }

  // Start polling
  let tailTimeout = setTimeout(poll, currentPollInterval);

  rl.on("line", async (line) => {
    const text = line.trim();
    if (!text) {
      rl.prompt();
      return;
    }

    if (text === "/clear" || text.startsWith("/clear")) {
      console.clear();
      rl.prompt();
      return;
    }

    if (text.startsWith("/help")) {
      console.log("\n\x1b[1mAvailable REPL Commands:\x1b[0m");
      console.log("  \x1b[32m/upload <filepath>\x1b[0m   Attach and send local text file content");
      console.log("  \x1b[32m/approve\x1b[0m           Approve the generated plan");
      console.log("  \x1b[32m/rename <name>\x1b[0m       Set a custom display name/label for the REPL prompt");
      console.log("  \x1b[32m/color <color>\x1b[0m      Change prompt color (green, cyan, blue, yellow, magenta, red, white, default)");
      console.log("  \x1b[32m/queue\x1b[0m              List currently queued messages");
      console.log("  \x1b[32m/edit\x1b[0m               Edit currently queued messages in $EDITOR");
      console.log("  \x1b[32m/flush\x1b[0m              Flush and send queued message(s) immediately");
      console.log("  \x1b[32m/clear\x1b[0m              Clear terminal screen");
      console.log("  \x1b[32m/help\x1b[0m               Display this help message");
      console.log("  \x1b[32m@<filepath>\x1b[0m          Inline syntax to attach file content in prompt\n");
      rl.prompt();
      return;
    }

    if (text.startsWith("/color")) {
      const parts = text.split(/\s+/).filter(Boolean);
      const colorArg = parts[1] ? parts[1].toLowerCase() : "";

      const colors = {
        green: "\x1b[32m",
        cyan: "\x1b[36m",
        blue: "\x1b[34m",
        yellow: "\x1b[33m",
        magenta: "\x1b[35m",
        red: "\x1b[31m",
        white: "\x1b[37m",
        reset: "\x1b[0m",
        none: "\x1b[0m",
        default: "\x1b[32m"
      };

      if (!colorArg || !colors[colorArg]) {
        console.error("\x1b[31m❌ Error: Please specify a valid color: green, cyan, blue, yellow, magenta, red, white, default, reset.\x1b[0m");
        rl.prompt();
        return;
      }

      promptColorCode = colors[colorArg];
      updatePrompt();
      console.error(`\x1b[32m✔ REPL prompt color set to ${colorArg}.\x1b[0m`);
      rl.prompt();
      return;
    }

    if (text === "/edit") {
      const editor = process.env.EDITOR;
      if (!editor) {
        console.error("\x1b[31m❌ Error: Cannot use /edit because `$EDITOR` environment variable is not defined.\x1b[0m");
        console.error("\x1b[90mPlease set `$EDITOR` in your environment (e.g. export EDITOR=vim) to enable editing queued messages in your terminal.\x1b[0m");
        rl.prompt();
        return;
      }

      const tmpFile = path.join(os.tmpdir(), `jules-queue-${Date.now()}.md`);
      try {
        const initialContent = messageQueue.join("\n\n---\n\n");
        fs.writeFileSync(tmpFile, initialContent, "utf8");

        rl.pause();
        execSync(`${editor} "${tmpFile}"`, { stdio: "inherit" });
        rl.resume();

        const editedContent = fs.readFileSync(tmpFile, "utf8").trim();
        messageQueue.length = 0;

        if (editedContent) {
          const parts = editedContent.split(/\n\s*---\s*\n/).map(s => s.trim()).filter(Boolean);
          messageQueue.push(...parts);
          saveQueue(fullSessionId, messageQueue);
          console.error(`\x1b[32m✔ Queue updated via editor (${messageQueue.length} message(s)).\x1b[0m`);
        } else {
          saveQueue(fullSessionId, messageQueue);
          console.error(`\x1b[32m✔ File saved empty. Queue cleared.\x1b[0m`);
        }
        updatePrompt();
      } catch (err) {
        console.error(`\x1b[31m❌ Error editing queue in $EDITOR: ${err.message}\x1b[0m`);
      } finally {
        try { if (fs.existsSync(tmpFile)) fs.unlinkSync(tmpFile); } catch (e) {}
      }
      rl.prompt();
      return;
    }

    if (text === "/queue") {
      if (messageQueue.length === 0) {
        console.log("\x1b[90mNo queued messages.\x1b[0m");
      } else {
        console.log(`\n\x1b[1mQueued Messages (${messageQueue.length}):\x1b[0m`);
        messageQueue.forEach((msg, i) => {
          console.log(`\x1b[36m${i + 1}.\x1b[0m ${msg}`);
        });
        console.log("");
      }
      rl.prompt();
      return;
    }

    if (text.startsWith("/rename")) {
      const newName = text.slice(7).trim();
      if (!newName) {
        console.error("\x1b[31m❌ Error: /rename requires a <name> argument.\x1b[0m");
        rl.prompt();
        return;
      }
      basePromptLabel = newName;
      updatePrompt();
      console.log(`\x1b[32m✔ REPL prompt renamed to: ${newName}\x1b[0m`);
      rl.prompt();
      return;
    }

    if (text === "/flush" || text === "/now" || text.startsWith("/flush") || text.startsWith("/now")) {
      if (messageQueue.length === 0) {
        console.error("\x1b[31m❌ Error: No queued messages to flush.\x1b[0m");
        rl.prompt();
        return;
      }
      const combinedPayload = messageQueue.join("\n\n---\n\n");
      messageQueue.length = 0;
      saveQueue(fullSessionId, messageQueue);
      updatePrompt();
      isBusy = true;
      try {
        await apiRequest(`${fullSessionId}:sendMessage`, "POST", { prompt: combinedPayload });
        console.log(`\x1b[90m(Messages flushed and sent immediately... Agent is thinking...)\x1b[0m`);
        clearTimeout(tailTimeout);
        tailTimeout = setTimeout(async () => {
          await poll();
        }, Math.min(2000, basePollInterval));
      } catch (err) {
        console.error(`\x1b[31mError sending message: ${err.message}\x1b[0m`);
        isBusy = false;
      }
      rl.prompt();
      return;
    }

    if (text === "/approve" || text.startsWith("/approve")) {
      try {
        await apiRequest(`${fullSessionId}:approvePlan`, "POST", {});
        console.log(`\x1b[32m✔ Plan approved!\x1b[0m`);
        clearTimeout(tailTimeout);
        tailTimeout = setTimeout(async () => {
          await poll();
        }, 2000);
      } catch (err) {
        console.error(`\x1b[31m❌ Error approving plan: ${err.message}\x1b[0m`);
      }
      rl.prompt();
      return;
    }

    if (text.startsWith("/upload")) {
      const parts = text.split(/\s+/).filter(Boolean);
      if (parts.length === 1) {
        console.error("\x1b[31m❌ Error: /upload requires a <filepath> argument.\x1b[0m");
        rl.prompt();
        return;
      }
      if (parts.length > 2) {
        console.error("\x1b[31m❌ Error: /upload expects strictly 1 argument (<filepath>). Additional text or arguments are not allowed.\x1b[0m");
        rl.prompt();
        return;
      }
      const filepath = parts[1];
      try {
        const formatted = readAndFormatLocalFile(filepath);
        if (isBusy) {
          messageQueue.push(formatted.trim());
          saveQueue(fullSessionId, messageQueue);
          updatePrompt();
          console.log(`\x1b[33m⏳ Jules is working. File uploaded and queued. (Type /flush to send immediately)\x1b[0m`);
        } else {
          isBusy = true;
          try {
            await apiRequest(`${fullSessionId}:sendMessage`, "POST", { prompt: formatted.trim() });
            console.log(`\x1b[90m(File uploaded... Agent is thinking...)\x1b[0m`);
            clearTimeout(tailTimeout);
            tailTimeout = setTimeout(async () => {
              await poll();
            }, 2000);
          } catch (err) {
            console.error(`\x1b[31mError sending file message: ${err.message}\x1b[0m`);
            isBusy = false;
          }
        }
      } catch (err) {
        console.error(`\x1b[31m❌ Error uploading file: ${err.message}\x1b[0m`);
      }
      rl.prompt();
      return;
    }

    let promptToSend = text;
    try {
      promptToSend = expandAtFilepaths(text);
    } catch (err) {
      console.error(`\x1b[31m❌ Error reading file: ${err.message}\x1b[0m`);
      rl.prompt();
      return;
    }

    if (isBusy || messageQueue.length > 0) {
      messageQueue.push(promptToSend);
      saveQueue(fullSessionId, messageQueue);
      updatePrompt();
      console.log(`\x1b[33m⏳ Jules is working. Message queued and will be sent automatically when Jules is ready. (Type /flush to send immediately)\x1b[0m`);
      rl.prompt();
      return;
    }

    // Check state before sending directly to ensure Jules is not working
    try {
      const session = await apiRequest(fullSessionId, "GET", null, true);
      if (session.state === "IN_PROGRESS" || session.state === "ACTIVE") {
        isBusy = true;
        messageQueue.push(promptToSend);
        saveQueue(fullSessionId, messageQueue);
        updatePrompt();
        console.log(`\x1b[33m⏳ Jules is working. Message queued and will be sent automatically when Jules is ready. (Type /flush to send immediately)\x1b[0m`);
        rl.prompt();
        return;
      }
    } catch (err) {
      log(`Pre-send session state check failed: ${err.message}`);
    }

    isBusy = true;
    hasPulledForWork = false;
    try {
      await apiRequest(`${fullSessionId}:sendMessage`, "POST", { prompt: promptToSend });
      console.error(`\x1b[90m(Message sent... Agent is thinking...)\x1b[0m`);
      
      // Wait a bit for the agent to start processing before triggering a poll
      clearTimeout(tailTimeout);
      tailTimeout = setTimeout(async () => {
        await poll();
      }, 2000);
    } catch (err) {
      console.error(`\x1b[31mError sending message: ${err.message}\x1b[0m`);
      isBusy = false;
    }
    rl.prompt();
  });

  rl.on("close", () => {
    clearTimeout(tailTimeout);
    process.exit(0);
  });
}

async function main() {
  if (!API_KEY) {
    console.error("\x1b[31m❌ Error: `JULES_API_KEY` environment variable is not set.\x1b[0m");
    process.exit(1);
  }

  await yargs(hideBin(process.argv))
    .scriptName("jules")
    .usage("Jules CLI - AI Session Manager\n\nUsage: $0 <command> [options]")
    .command("sessions", "List all available AI sessions", {}, async () => {
      await listSessions();
    })
    .command("sources", "List available code sources (repositories)", {}, async () => {
      await listSources();
    })
    .command("cleanup", "Archive sessions older than one week", {}, async () => {
      await cleanup();
    })
    .command(
      "create <prompt>",
      "Start a new session with an initial prompt (supports @filepath)",
      (y) => {
        return y
          .positional("prompt", { type: "string", describe: "Initial prompt for the session" })
          .option("source", { type: "string", describe: "Link the session to a specific code source" });
      },
      async (argv) => {
        let finalPrompt = argv.prompt;
        try {
          finalPrompt = expandAtFilepaths(argv.prompt);
        } catch (err) {
          console.error(`\x1b[31m❌ Error reading file: ${err.message}\x1b[0m`);
          process.exit(1);
        }
        const newSessionId = await createSession(finalPrompt, argv.source);
        await repl(newSessionId);
      }
    )
    .command(
      "tail [sessionId]",
      "Live-stream session activities (defaults to latest)",
      (y) => {
        return y
          .positional("sessionId", { type: "string", describe: "Session ID to tail" })
          .option("s", { alias: "session", type: "string", describe: "Session ID to tail" })
          .option("history", { type: "boolean", describe: "Fetch and print full activity history on startup" })
          .option("git-patch", { type: "boolean", describe: "Automatically apply received git patches to repository" });
      },
      async (argv) => {
        let targetSessionId = argv.session || argv.sessionId;
        if (!targetSessionId) {
          try {
            const sessions = await fetchSessions();
            if (sessions.length === 0) {
              console.error("\x1b[31m❌ Error: No sessions found to tail.\x1b[0m");
              process.exit(1);
            }
            targetSessionId = sessions[0].name || sessions[0].id;
            console.log(`\x1b[90mNo session ID provided. Defaulting to latest: ${targetSessionId}\x1b[0m`);
          } catch (err) {
            console.error(`\x1b[31m❌ Error fetching latest session: ${err.message}\x1b[0m`);
            process.exit(1);
          }
        }
        await tail(targetSessionId, argv);
      }
    )
    .command(
      "repl [sessionIdOrPrompt]",
      "Interactive shell to chat with a session (supports /upload, /approve, /rename, /flush, /help, @filepath)",
      (y) => {
        return y
          .positional("sessionIdOrPrompt", { type: "string", describe: "Session ID or initial prompt" })
          .option("s", { alias: "session", type: "string", describe: "Session ID for REPL" })
          .option("c", { alias: "create", type: "boolean", describe: "Create a new session (requires a prompt argument)" })
          .option("source", { type: "string", describe: "Link or filter by a specific code source" })
          .option("name", { type: "string", describe: "Set a custom display name/label for the REPL prompt" })
          .option("history", { type: "boolean", describe: "Fetch and print full activity history on startup" })
          .option("git-pull", { type: "boolean", describe: "Automatically run 'git pull' before starting the REPL" })
          .option("git-patch", { type: "boolean", describe: "Automatically apply received git patches to repository" });
      },
      async (argv) => {
        if (argv.create) {
          if (argv.session) {
            console.error("\x1b[31m❌ Error: Cannot specify `--session` option when creating a new session.\x1b[0m");
            process.exit(1);
          }
          if (!argv.sessionIdOrPrompt) {
            console.error("\x1b[31m❌ Error: A prompt argument is required when using `--create`.\x1b[0m");
            process.exit(1);
          }
          let initialPrompt = argv.sessionIdOrPrompt;
          try {
            initialPrompt = expandAtFilepaths(argv.sessionIdOrPrompt);
          } catch (err) {
            console.error(`\x1b[31m❌ Error reading file: ${err.message}\x1b[0m`);
            process.exit(1);
          }
          const newSessionId = await createSession(initialPrompt, argv.source);
          await repl(newSessionId, argv);
          return;
        }

        const explicitSessionId = argv.session || argv.sessionIdOrPrompt;

        if (explicitSessionId) {
          if (argv.source) {
            console.log("\x1b[33m⚠️ Warning: Specifying `--source` is not necessary when passing an explicit session ID.\x1b[0m");
          }
          await repl(explicitSessionId, argv);
          return;
        }

        if (argv.source) {
          let fullSourceId = argv.source;
          if (typeof fullSourceId === "string" && !fullSourceId.startsWith("sources/")) {
            try {
              const sources = await fetchSources();
              const matched = sources.find(s => s.githubRepo && `${s.githubRepo.owner}/${s.githubRepo.repo}` === argv.source);
              if (matched) fullSourceId = matched.name;
            } catch (err) {
              log(`Failed to resolve source in REPL: ${err.message}`);
            }
          }

          try {
            const sessions = await fetchSessions();
            const matchingSessions = sessions.filter(s => {
              const sSource = s.source || s.sourceId;
              return sSource === fullSourceId || sSource === argv.source;
            });

            if (matchingSessions.length === 0) {
              console.error(`\x1b[31m❌ Error: No existing sessions found for source '${argv.source}'. Pass '--create <prompt>' to start a new session.\x1b[0m`);
              process.exit(1);
            }

            const latestSession = matchingSessions[0].name || matchingSessions[0].id;
            console.log(`\x1b[90mConnecting to latest session for ${argv.source}: ${latestSession}\x1b[0m`);
            await repl(latestSession, argv);
          } catch (err) {
            console.error(`\x1b[31m❌ Error fetching sessions for source: ${err.message}\x1b[0m`);
            process.exit(1);
          }
          return;
        }

        await repl(null, argv);
      }
    )
    .command(
      "approve",
      "Approve a generated plan for a session",
      (y) => {
        return y.option("s", { alias: "session", type: "string", describe: "Session ID to approve plan for" });
      },
      async (argv) => {
        if (!argv.session) {
          console.error("\x1b[31m❌ Error: `--session` option is required for approve command.\x1b[0m");
          process.exit(1);
        }
        const fullSessionId = argv.session.startsWith("sessions/") ? argv.session : `sessions/${argv.session}`;
        console.log(`\x1b[36mApproving plan for session:\x1b[0m ${fullSessionId}...`);
        await apiRequest(`${fullSessionId}:approvePlan`, "POST", {});
        console.log(`\x1b[32m✔ Plan approved successfully!\x1b[0m`);
      }
    )
    .command(
      "send [message]",
      "Send a message to a session and tail until status is done/completed (supports stdin and @filepath)",
      (y) => {
        return y
          .positional("message", { type: "string", describe: "Message prompt to send" })
          .option("s", { alias: "session", type: "string", describe: "Session ID to send message to" })
          .option("git-patch", { type: "boolean", describe: "Automatically apply received git patches to repository" });
      },
      async (argv) => {
        if (!argv.session) {
          console.error("\x1b[31m❌ Error: `--session` option is required for send command.\x1b[0m");
          process.exit(1);
        }
        let promptText = argv.message;
        if (!promptText || promptText === "-") {
          promptText = await readStdin();
          promptText = promptText.trim();
        }
        if (!promptText) {
          console.error("\x1b[31m❌ Error: A message or stdin input is required for send command.\x1b[0m");
          process.exit(1);
        }
        try {
          promptText = expandAtFilepaths(promptText);
        } catch (err) {
          console.error(`\x1b[31m❌ Error reading file: ${err.message}\x1b[0m`);
          process.exit(1);
        }
        await sendMessageAndTail(argv.session, promptText, argv);
      }
    )
    .demandCommand(1, "")
    .strict()
    .help()
    .parse();
}

main().catch((err) => {
  console.error(`\x1b[31m${err}\x1b[0m`);
  process.exit(1);
});
